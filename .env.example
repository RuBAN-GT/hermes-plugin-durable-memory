# Runtime backend: memory for local development, postgres for the PostgreSQL repository.
DURABLE_MEMORY_STORE=memory

# PostgreSQL runtime URL. Never commit real credentials.
# DURABLE_MEMORY_DATABASE_URL=postgresql://<runtime-user>:<password>@<host>:5432/<database>
# Use a separate migration-owner role for schema changes and profile bootstrap.
# DURABLE_MEMORY_MIGRATION_DATABASE_URL=postgresql://durable_memory_owner:password@127.0.0.1:5432/durable_memory

# Profile slug for this Hermes process. Defaults to HERMES_PROFILE or "default".
# DURABLE_MEMORY_PROFILE=default

# Per-operation approval policy: require | auto | deny
DURABLE_MEMORY_APPROVAL_CREATE=require
DURABLE_MEMORY_APPROVAL_UPDATE=require
DURABLE_MEMORY_APPROVAL_DELETE=require
DURABLE_MEMORY_APPROVAL_TTL_SECONDS=86400

# Optional embedding adapter. Leave unset to disable it (fail-closed).
# DURABLE_MEMORY_EMBEDDING_PROVIDER=ollama
# DURABLE_MEMORY_OLLAMA_BASE_URL=http://127.0.0.1:11434
# DURABLE_MEMORY_OLLAMA_MODEL=nomic-embed-text
# DURABLE_MEMORY_OLLAMA_TIMEOUT_SECONDS=10
